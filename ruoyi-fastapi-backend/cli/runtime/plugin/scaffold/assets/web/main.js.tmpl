import { createPluginClient } from '../vendor/pluginBridge.js'
import { applyLanguage, engine, t } from './i18n.js'
import './style.css'

// 只替换模板标签，插件标识与接口业务内容保持原样。
const element = (id) => document.getElementById(id)
let client
let context = {}
let connected = false
let ended = false
let pluginId = null
let serverTime = null
let notice = null

function render() {
  element('application').textContent = t('plugin.__PLUGIN_ID__:application')
  element('refresh').textContent = t('plugin.__PLUGIN_ID__:refresh')
  element('plugin-label').textContent = t('plugin.__PLUGIN_ID__:pluginId')
  element('time-label').textContent = t('plugin.__PLUGIN_ID__:serverTime')
  element('plugin-id').textContent = ended
    ? t('plugin.__PLUGIN_ID__:ended')
    : pluginId || t('plugin.__PLUGIN_ID__:waiting')
  element('server-time').textContent = serverTime
    ? new Intl.DateTimeFormat(engine.language, {
        timeZone: context.timeZone || 'UTC', dateStyle: 'short', timeStyle: 'medium',
      }).format(new Date(serverTime))
    : ended ? '—' : t('plugin.__PLUGIN_ID__:waiting')
  element('notice').textContent = notice ? t(notice.key, notice.params) : t('plugin.__PLUGIN_ID__:connecting')
  element('notice').classList.toggle('error', notice?.error || false)
}

const showNotice = (key, params = {}, error = false) => {
  notice = { key, params, error }
  render()
}
const setBusy = (busy) => {
  element('workspace').setAttribute('aria-busy', String(busy))
  element('refresh').disabled = busy || ended
}
const applyContext = (next) => {
  context = { ...context, ...next }
  document.documentElement.dataset.theme = context.theme?.mode || 'light'
  applyLanguage(context.language)
  render()
}

// 偏好通知只重新渲染界面，不刷新 iframe 或重新请求业务数据。
async function refresh() {
  if (!connected || ended) return
  setBusy(true)
  try {
    const result = await client.request({ method: 'GET', path: 'info' })
    if (ended) return
    pluginId = result.pluginId
    serverTime = result.serverTime
    showNotice('plugin.__PLUGIN_ID__:ready')
  } catch {
    if (!ended) showNotice('plugin.__PLUGIN_ID__:retry', {}, true)
  } finally {
    setBusy(false)
  }
}
async function connect() {
  setBusy(true)
  try {
    client?.destroy()
    const config = JSON.parse(element('ruoyi-plugin-config').textContent)
    client = createPluginClient({ pluginId: config.pluginId })
    client.subscribe(({ type, payload }) => {
      if (type === 'preferences' || type === 'route') applyContext(payload)
      if (type === 'refresh') refresh()
      if (type === 'logout') {
        ended = true
        connected = false
        serverTime = null
        client.destroy()
        showNotice('plugin.__PLUGIN_ID__:loggedOut')
        setBusy(false)
      }
    })
    applyContext(await client.ready)
    connected = true
    await refresh()
  } catch {
    connected = false
    showNotice('plugin.__PLUGIN_ID__:openFromHost', {}, true)
    setBusy(false)
  }
}
element('refresh').addEventListener('click', () => connected ? refresh() : connect())
window.addEventListener('pagehide', () => client?.destroy(), { once: true })
applyContext({})
connect()
