msgstr "Invalid table creation statement"

msgid "generator.mysqlTimeAmbiguous"
msgstr ""
"MySQL TIME may represent a duration. If this field is a time of day, select the Time of day display type. For "
"durations, use a numeric column with an explicit unit and import it again."

msgid "generator.outputMustBeBundleRoot"
msgstr "Choose a separate output directory instead of an application source directory."

msgid "generator.postgresTimestampAmbiguous"
msgstr ""
"A PostgreSQL timestamp without a time zone is ambiguous. Convert instant columns to TIMESTAMP(3) WITH TIME ZONE and "
"import the generation configuration again."

msgid "generator.renderFailed"
msgstr "Unable to render the template for table %(table_name)s. Check the service logs"

msgid "generator.tableCreateFailed"
msgstr "Unable to create the table structure. Check the service logs"

msgid "generator.tableCreated"
msgstr "Table structure created successfully"

msgid "generator.tableIdRequired"
msgstr "Business table ID is required"

msgid "generator.tableNotFound"
msgstr "Business table not found"

msgid "generator.tableOutsideSource"
msgstr "The business table does not exist or does not belong to data source %(source_name)s: %(table_name)s"

msgid "generator.tablesOutsideSource"
msgstr "These business tables do not exist or do not belong to data source %(source_name)s: %(value)s"

msgid "generator.timeWithZoneUnsupported"
msgstr ""
"A time with a time zone cannot be generated as a time of day. Use TIME WITHOUT TIME ZONE for times of day or "
"TIMESTAMP(3) WITH TIME ZONE for instants."

msgid "generator.treeCodeRequired"
msgstr "Tree code field is required"

