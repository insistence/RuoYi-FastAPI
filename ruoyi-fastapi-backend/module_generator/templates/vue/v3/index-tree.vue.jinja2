{% set hasUserDateQuery = columns | selectattr('query') | selectattr('time_kind', 'equalto', 'instant') | selectattr('query_type', 'equalto', 'BETWEEN') | list %}
{% macro picker(column, model, vue3=True, range=False) -%}
{% set date_format = 'YYYY-MM-DD' if vue3 else 'yyyy-MM-dd' %}
{% if column.time_kind == 'instant' and not range %}
<business-date-time-picker v-model="{{ model }}" :timezone="getTimeFieldsTimezone({{ model.rsplit('.', 1)[0] }})" :label="t('{{ i18nFieldKey(column) }}')" />
{% elif column.time_kind == 'time' %}
<el-time-picker
  v-model="{{ model }}"
  {% if range %}is-range{% endif %}
  value-format="HH:mm:ss.SSS"
  format="HH:mm:ss"
  clearable
  :placeholder="t('{{ i18nFieldKey(column, "select") }}')"
/>
{% else %}
<el-date-picker
  v-model="{{ model }}"
  type="{{ 'daterange' if range else 'datetime' if column.time_kind == 'instant' else 'date' }}"
  value-format="{{ date_format }}{{ ' HH:mm:ss' if not range and column.time_kind == 'instant' else '' }}"
  {% if range %}
  range-separator="-"
  start-:placeholder="t('system:startDate')"
  end-:placeholder="t('system:endDate')"
  {% else %}
  :placeholder="t('{{ i18nFieldKey(column, "select") }}')"
  {% endif %}
  clearable
/>
{% endif %}
{%- endmacro %}
<template>
  <div class="app-container">
    <el-form :model="queryParams" ref="queryRef" :inline="true" v-show="showSearch" label-width="auto">
      {% for column in columns %}
      {% if column.query %}
      {% set dictType = column.dict_type %}
      {% set AttrName = column.python_field[0] | upper + column.python_field[1:] %}
      {% set parentheseIndex = column.column_comment.find("（") %}
      {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
      {% if column.html_type == "input" %}
      <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ column.python_field }}">
        <el-input
          v-model="queryParams.{{ column.python_field }}"
          :placeholder="t('{{ i18nFieldKey(column, "input") }}')"
          clearable
          style="width: 240px"
          @keyup.enter="handleQuery"
        />
      </el-form-item>
      {% elif (column.html_type == "select" or column.html_type == "radio") and dictType %}
      <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ column.python_field }}">
        <el-select v-model="queryParams.{{ column.python_field }}" :placeholder="t('{{ i18nFieldKey(column, "select") }}')" clearable style="width: 240px">
          <el-option
            v-for="dict in {{ dictType }}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>
      {% elif (column.html_type == "select" or column.html_type == "radio") and not dictType %}
      <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ column.python_field }}">
        <el-select v-model="queryParams.{{ column.python_field }}" :placeholder="t('{{ i18nFieldKey(column, "select") }}')" clearable style="width: 240px">
          <el-option :label="t('{{ i18nText("dictionary.configure", "请选择字典生成", "Select a dictionary in generator settings") }}')" value="" />
        </el-select>
      </el-form-item>
      {% elif column.time_kind and column.query_type != "BETWEEN" %}
      <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ column.python_field }}">
        {{ picker(column, "queryParams." ~ column.python_field ~ "", True, False) | indent(10) }}
      </el-form-item>
      {% elif column.time_kind and column.query_type == "BETWEEN" %}
      <el-form-item :label="t('{{ i18nFieldKey(column) }}')" style="width: 308px">
        {{ picker(column, "daterange" ~ AttrName ~ "", True, True) | indent(10) }}
      </el-form-item>
      {% endif %}
      {% endif %}
      {% endfor %}
      <el-form-item>
        <el-button type="primary" icon="Search" @click="handleQuery">{% raw %}{{{% endraw %} t('system:search') {% raw %}}}{% endraw %}</el-button>
        <el-button icon="Refresh" @click="resetQuery">{% raw %}{{{% endraw %} t('system:reset') {% raw %}}}{% endraw %}</el-button>
      </el-form-item>
    </el-form>

    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button
          type="primary"
          plain
          icon="Plus"
          @click="handleAdd"
          v-hasPermi="['{{ moduleName }}:{{ businessName }}:add']"
        >{% raw %}{{{% endraw %} t('system:add') {% raw %}}}{% endraw %}</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          type="info"
          plain
          icon="Sort"
          @click="toggleExpandAll"
        >{% raw %}{{{% endraw %} t('system:expandCollapse') {% raw %}}}{% endraw %}</el-button>
      </el-col>
      <right-toolbar v-model:showSearch="showSearch" @queryTable="getList"></right-toolbar>
    </el-row>

    <el-table
      v-if="refreshTable"
      v-loading="loading"
      :data="{{ businessName }}List"
      row-key="{{ treeCode }}"
      :default-expand-all="isExpandAll"
      :tree-props="{children: 'children', hasChildren: 'hasChildren'}"
    >
      {% for column in columns %}
      {% set pythonField = column.python_field %}
      {% set parentheseIndex = column.column_comment.find("（") %}
      {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
      {% if column.pk %}
      {% elif column.list and column.time_kind == "instant" %}
      <el-table-column :label="t('{{ i18nFieldKey(column) }}')" align="center" prop="{{ pythonField }}" width="180">
        <template #default="scope">
          <span>{% raw %}{{{% endraw %} parseTime(scope.row.{{ pythonField }}) {% raw %}}}{% endraw %}</span>
        </template>
      </el-table-column>
      {% elif column.list and column.html_type == "imageUpload" %}
      <el-table-column :label="t('{{ i18nFieldKey(column) }}')" align="center" prop="{{ pythonField }}" width="100">
        <template #default="scope">
          <image-preview :src="scope.row.{{ pythonField }}" :width="50" :height="50"/>
        </template>
      </el-table-column>
      {% elif column.list and column.dict_type %}
      <el-table-column :label="t('{{ i18nFieldKey(column) }}')" align="center" prop="{{ pythonField }}">
        <template #default="scope">
          {% if column.html_type == "checkbox" %}
            <dict-tag :options="{{ column.dict_type }}" :value="scope.row.{{ pythonField }} ? scope.row.{{ pythonField }}.split(',') : []"/>
          {% else %}
            <dict-tag :options="{{ column.dict_type }}" :value="scope.row.{{ pythonField }}"/>
          {% endif %}
        </template>
      </el-table-column>
      {% elif column.list and pythonField %}
      <el-table-column :label="t('{{ i18nFieldKey(column) }}')" align="center" prop="{{ pythonField }}" />
      {% endif %}
      {% endfor %}
      <el-table-column :label="t('system:actions')" align="center" class-name="small-padding fixed-width">
        <template #default="scope">
          {% if genView %}
          <el-button link type="primary" icon="View" @click="handleViewData(scope.row)" v-hasPermi="['{{ moduleName }}:{{ businessName }}:query']">{% raw %}{{{% endraw %} t('components:details') {% raw %}}}{% endraw %}</el-button>
          {% endif %}
          <el-button link type="primary" icon="Edit" @click="handleUpdate(scope.row)" v-hasPermi="['{{ moduleName }}:{{ businessName }}:edit']">{% raw %}{{{% endraw %} t('system:edit') {% raw %}}}{% endraw %}</el-button>
          <el-button link type="primary" icon="Plus" @click="handleAdd(scope.row)" v-hasPermi="['${moduleName}:${businessName}:add']">{% raw %}{{{% endraw %} t('system:add') {% raw %}}}{% endraw %}</el-button>
          <el-button link type="primary" icon="Delete" @click="handleDelete(scope.row)" v-hasPermi="['{{ moduleName }}:{{ businessName }}:remove']">{% raw %}{{{% endraw %} t('system:delete') {% raw %}}}{% endraw %}</el-button>
        </template>
      </el-table-column>
    </el-table>

    {% if genView %}
    <!-- {{ functionName }}详情抽屉 -->
    <{{ businessName }}-view-drawer ref="{{ businessName }}ViewRef" />
    {% endif %}
    <!-- 添加或修改{{ functionName }}对话框 -->
    {% if table.form_col_num == 2 %}
    {% set dialogWidth = "800px" %}
    {% elif table.form_col_num == 3 %}
    {% set dialogWidth = "1100px" %}
    {% else %}
    {% set dialogWidth = "500px" %}
    {% endif %}
    <el-dialog :title="title" v-model="open" width="{{ dialogWidth }}" append-to-body>
      <el-form ref="{{ businessName }}Ref" :model="form" :rules="rules" :validate-on-rule-change="false" label-width="auto">
        <el-row>
      {% for column in columns %}
      {% set field = column.python_field %}
      {% if (column.insert or column.edit) and not column.pk and column.column_name not in column_not_add_show + column_not_edit_show %}
      {% if column.usable_column or not column.super_column %}
      {% set parentheseIndex = column.column_comment.find("（") %}
      {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
      {% set dictType = column.dict_type %}
      {% if treeParentCode and column.python_field == treeParentCode %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ treeParentCode }}">
              <el-tree-select
                v-model="form.{{ treeParentCode }}"
                :data="{{ businessName }}Options"
                :props="{ value: '{{ treeCode }}', label: '{{ treeName }}', children: 'children' }"
                value-key="{{ treeCode }}"
                :placeholder="t('{{ i18nFieldKey(column, "select") }}')"
                check-strictly
              />
            </el-form-item>
          </el-col>
      {% elif column.html_type == "input" %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-input v-model="form.{{ field }}" :placeholder="t('{{ i18nFieldKey(column, "input") }}')" />
            </el-form-item>
          </el-col>
      {% elif column.html_type == "imageUpload" %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <image-upload v-model="form.{{ field }}"/>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "fileUpload" %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <file-upload v-model="form.{{ field }}"/>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "editor" %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="24">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <editor v-model="form.{{ field }}" :min-height="192"/>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "select" and dictType %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-select v-model="form.{{ field }}" :placeholder="t('{{ i18nFieldKey(column, "select") }}')">
                <el-option
                  v-for="dict in {{ dictType }}"
                  :key="dict.value"
                  :label="dict.label"
                  {% if column.python_type == 'int' %}
                  :value="parseInt(dict.value)"
                  {% else %}
                  :value="dict.value"
                  {% endif %}
                ></el-option>
              </el-select>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "select" and not dictType %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-select v-model="form.{{ field }}" :placeholder="t('{{ i18nFieldKey(column, "select") }}')">
                <el-option :label="t('{{ i18nText("dictionary.configure", "请选择字典生成", "Select a dictionary in generator settings") }}')" value="" />
              </el-select>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "checkbox" and dictType %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-checkbox-group v-model="form.{{ field }}">
                <el-checkbox
                  v-for="dict in {{ dictType }}"
                  :key="dict.value"
                  :label="dict.value">
                  {% raw %}{{{% endraw %} dict.label {% raw %}}}{% endraw %}
                </el-checkbox>
              </el-checkbox-group>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "checkbox" and not dictType %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-checkbox-group v-model="form.{{ field }}">
                <el-checkbox>{% raw %}{{{% endraw %} t('{{ i18nText("dictionary.configure", "请选择字典生成", "Select a dictionary in generator settings") }}') {% raw %}}}{% endraw %}</el-checkbox>
              </el-checkbox-group>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "radio" and dictType %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-radio-group v-model="form.{{ field }}">
                <el-radio
                  v-for="dict in {{ dictType }}"
                  :key="dict.value"
                  {% if column.python_type == 'int' %}
                  :label="parseInt(dict.value)"
                  {% else %}
                  :label="dict.value"
                  {% endif %}>
                  {% raw %}{{{% endraw %} dict.label {% raw %}}}{% endraw %}
                </el-radio>
              </el-radio-group>
            </el-form-item>
          </el-col>
      {% elif column.html_type == "radio" and not dictType %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-radio-group v-model="form.{{ field }}">
                <el-radio :label="t('{{ i18nText("dictionary.configure", "请选择字典生成", "Select a dictionary in generator settings") }}')" value="" />
              </el-radio-group>
            </el-form-item>
          </el-col>
      {% elif column.time_kind %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="{{ colSpan }}">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              {{ picker(column, "form." ~ field ~ "", True, False) | indent(10) }}
            </el-form-item>
          </el-col>
      {% elif column.html_type == "textarea" %}
          <el-col v-if="renderField({{ column.insert | lower }}, {{ column.edit | lower }})" :span="24">
            <el-form-item :label="t('{{ i18nFieldKey(column) }}')" prop="{{ field }}">
              <el-input v-model="form.{{ field }}" type="textarea" :placeholder="t('system:enterContent')" />
            </el-form-item>
          </el-col>
      {% endif %}
      {% endif %}
      {% endif %}
      {% endfor %}
        </el-row>
      </el-form>
      <template #footer>
        <div class="dialog-footer">
          <el-button type="primary" @click="submitForm">{% raw %}{{{% endraw %} t('system:confirm') {% raw %}}}{% endraw %}</el-button>
          <el-button @click="cancel">{% raw %}{{{% endraw %} t('system:cancel') {% raw %}}}{% endraw %}</el-button>
        </div>
      </template>
    </el-dialog>
  </div>
</template>

<script setup name="{{ BusinessName }}">
import { t } from "@/i18n/adapter";
import { useLocaleForm } from "@/composables/useLocaleForm";
import BusinessDateTimePicker from "@/components/BusinessDateTimePicker";
import { list{{ BusinessName }}, get{{ BusinessName }}, del{{ BusinessName }}, add{{ BusinessName }}, update{{ BusinessName }} } from "@/api/{{ moduleName }}/{{ businessName }}";
import { {% if hasUserDateQuery %}getDisplayTimezone, {% endif %}getTimeFieldsTimezone, prepareTimeFields, serializeTimeFieldsForSubmit } from "@/utils/time";
{% if genView %}
import {{ BusinessName }}ViewDrawer from "./view";
{% endif %}

const { proxy } = getCurrentInstance();
{% if dicts %}
{% set dictsNoSymbol = dicts.replace("'", "") %}
const { {{ dictsNoSymbol }} } = proxy.useDict({{ dicts }});
{% endif %}

const {{ businessName }}List = ref([]);
const {{ businessName }}Options = ref([]);
const open = ref(false);
const loading = ref(true);
const showSearch = ref(true);
const dialogMode = ref("create");
const title = computed(() => dialogMode.value === "create"
  ? t('{{ i18nKey("createTitle") }}')
  : t('{{ i18nKey("editTitle") }}'));
const isExpandAll = ref(true);
const refreshTable = ref(true);
{% for column in columns %}
{% if column.time_kind and column.query_type == "BETWEEN" %}
{% set AttrName = column.python_field[0] | upper + column.python_field[1:] %}
const daterange{{ AttrName }} = ref([]);
{% endif %}
{% endfor %}

const data = reactive({
  form: {},
  queryParams: {
    {% for column in columns %}
    {% if column.query %}
    {{ column.python_field }}: undefined,
    {% endif %}
    {% endfor %}
  },
  rules: {
    {% for column in columns %}
    {% if column.required %}
    {% set parentheseIndex = column.column_comment.find("（") %}
    {% set comment = column.column_comment[:parentheseIndex] if parentheseIndex != -1 else column.column_comment %}
    {{ column.python_field }}: [
      { required: true, get message() { return t('{{ i18nFieldKey(column, "required") }}'); }, trigger: "{% if column.html_type == 'select' or column.html_type == 'radio' %}change{% else %}blur{% endif %}" }
    ],
    {% endif %}
    {% endfor %}
  }
});

const { queryParams, form, rules } = toRefs(data);
useLocaleForm(() => proxy.$refs.{{ businessName }}Ref);

/** 查询{{ functionName }}列表 */
async function getList() {
  loading.value = true;
  {% for column in columns %}
  {% if column.time_kind and column.query_type == "BETWEEN" %}
  queryParams.value.params = {};
  {% endif %}
  {% endfor %}
  {% for column in columns %}
  {% if column.time_kind and column.query_type == "BETWEEN" %}
  {% set AttrName = column.python_field[0] | upper + column.python_field[1:] %}
  queryParams.value.begin{{ AttrName }} = daterange{{ AttrName }}.value?.[0];
  queryParams.value.end{{ AttrName }} = daterange{{ AttrName }}.value?.[1];
  {% endif %}
  {% endfor %}
  const queryData = await serializeTimeFieldsForSubmit(queryParams.value, {{ instantQueryFields | tojson }});
  if (!queryData) {
    loading.value = false;
    return;
  }
  list{{ BusinessName }}(queryData).then(response => {
    {{ businessName }}List.value = proxy.handleTree(response.data, "{{ treeCode }}", "{{ treeParentCode }}");
    loading.value = false;
  });
}

/** 查询{{ functionName }}下拉树结构 */
function getTreeselect() {
  list{{ BusinessName }}().then(response => {
    {{ businessName }}Options.value = [];
    const data = { {{ treeCode }}: 0, get {{ treeName }}() { return t('{{ i18nText("tree.root", "顶级节点", "Root node") }}'); }, children: [] };
    data.children = proxy.handleTree(response.data, "{{ treeCode }}", "{{ treeParentCode }}");
    {{ businessName }}Options.value.push(data);
  });
}

/** 取消按钮 */
function cancel() {
  open.value = false;
  reset();
}

/** 表单重置 */
function reset() {
  form.value = prepareTimeFields({
    {% for column in columns %}
    {% if column.html_type == "checkbox" %}
    {{ column.python_field }}: [],
    {% else %}
    {{ column.python_field }}: null,
    {% endif %}
    {% endfor %}
  }, {{ instantFields | tojson }});
  proxy.resetForm("{{ businessName }}Ref");
}

/** 搜索按钮操作 */
function handleQuery() {
  getList();
}

/** 重置按钮操作 */
function resetQuery() {
  {% for column in columns %}
  {% if column.time_kind and column.query_type == "BETWEEN" %}
  {% set AttrName = column.python_field[0] | upper + column.python_field[1:] %}
  daterange{{ AttrName }}.value = [];
  {% endif %}
  {% endfor %}
  proxy.resetForm("queryRef");
  handleQuery();
}

/** 新增按钮操作 */
function handleAdd(row) {
  reset();
  getTreeselect();
  if (row != null && row.{{ treeCode }}) {
    form.value.{{ treeParentCode }} = row.{{ treeCode }};
  } else {
    form.value.{{ treeParentCode }} = 0;
  }
  open.value = true;
  dialogMode.value = "create";
}

/** 展开/折叠操作 */
function toggleExpandAll() {
  refreshTable.value = false;
  isExpandAll.value = !isExpandAll.value;
  nextTick(() => {
    refreshTable.value = true;
  });
}
{% if genView %}

/** 详情按钮操作 */
function handleViewData(row) {
  proxy.$refs["{{ businessName }}ViewRef"].open(row.{{ pkColumn.python_field }});
}
{% endif %}

/** 修改按钮操作 */
function handleUpdate(row) {
  reset();
  getTreeselect();
  if (row != null) {
    form.value.{{ treeParentCode }} = row.{{ treeParentCode }};
  }
  get{{ BusinessName }}(row.{{ pkColumn.python_field }}).then(response => {
    form.value = prepareTimeFields(response.data, {{ instantFields | tojson }});
    {% for column in columns %}
    {% if column.html_type == "checkbox" %}
    form.value.{{ column.python_field }} = form.value.{{ column.python_field }}.split(",");
    {% endif %}
    {% endfor %}
    open.value = true;
    dialogMode.value = "edit";
  });
}

/** 提交按钮 */
function submitForm() {
  proxy.$refs["{{ businessName }}Ref"].validate(async valid => {
    if (valid) {
      const submitData = await serializeTimeFieldsForSubmit(form.value, {{ instantFields | tojson }});
      if (!submitData) {
        return;
      }
      {% for column in columns %}
      {% if column.html_type == "checkbox" %}
      submitData.{{ column.python_field }} = (form.value.{{ column.python_field }} || []).join(",");
      {% endif %}
      {% endfor %}
      {% if table.sub %}
      submitData.{{ subclassName }}List = [];
      for (const row of {{ subclassName }}List.value) {
        const submitRow = await serializeTimeFieldsForSubmit(row, {{ subInstantFields | tojson }});
        if (!submitRow) {
          return;
        }
        submitData.{{ subclassName }}List.push(submitRow);
      }
      {% endif %}
      if (form.value.{{ pkColumn.python_field }} != null) {
        update{{ BusinessName }}(submitData).then(() => {
          proxy.$modal.msgSuccess(t('system:updatedSuccessfully'));
          open.value = false;
          getList();
        });
      } else {
        add{{ BusinessName }}(submitData).then(() => {
          proxy.$modal.msgSuccess(t('system:addedSuccessfully'));
          open.value = false;
          getList();
        });
      }
    }
  });
}

/** 删除按钮操作 */
function handleDelete(row) {
  proxy.$modal.confirm(t('{{ i18nKey("deleteConfirm") }}', { ids: row.{{ pkColumn.python_field }} })).then(function() {
    return del{{ BusinessName }}(row.{{ pkColumn.python_field }});
  }).then(() => {
    getList();
    proxy.$modal.msgSuccess(t('system:deletedSuccessfully'));
  }).catch(() => {});
}

/** 是否渲染字段 */
function renderField(insert, edit) {
  return form.value.{{ pkColumn.python_field }} == null ? insert : edit;
}

getList();
