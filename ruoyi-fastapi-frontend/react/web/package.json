{
  "name": "ruoyi-fastapi-react-web",
  "version": "2.0.0",
  "description": "RuoYi-FastAPI React Web 管理端",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build",
    "build:docker": "vite build --mode docker",
    "build:stage": "vite build --mode staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:contract",
    "test:unit": "pnpm test:auth-center && pnpm test:plugin && pnpm test:job && pnpm test:security && pnpm test:session",
    "test:security": "node --test tests/security/*.test.cjs",
    "test:contract": "pnpm test:time",
    "test:job": "node --test tests/job/*.test.js",
    "test:plugin": "node --test tests/plugins/*.test.js && pnpm test:components tests/react/pluginFrame.test.jsx tests/react/plugin-status.test.jsx",
    "test:auth-center": "node --test tests/auth-center/*.test.js && pnpm test:components tests/react/useInteraction.test.jsx",
    "test:time": "node --test tests/time/time.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "preview": "vite preview",
    "test:session": "node --experimental-vm-modules --test tests/security/logout.test.mjs",
    "i18n:check": "node scripts/check-i18n.mjs && x18n --root . check --json",
    "test:i18n": "node --test tests/i18n/*.test.mjs && pnpm test:components tests/react/i18n.test.jsx"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/x": "2.9.0",
    "antd": "6.6.6",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "file-saver": "2.0.5",
    "i18next": "26.5.11",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.5.4",
    "katex": "0.19.0",
    "markstream-react": "2.0.19",
    "mermaid": "12.2.0",
    "monaco-editor": "0.55.1",
    "quill": "2.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "5.5.7",
    "react-i18next": "17.1.9",
    "react-router-dom": "7.18.4",
    "stream-diffs": "0.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "@x18n/builtins": "0.1.3",
    "@x18n/cli": "0.1.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "vite": "8.3.4",
    "vite-plugin-compression": "0.5.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
