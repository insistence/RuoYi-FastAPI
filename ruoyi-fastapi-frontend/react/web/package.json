{
  "name": "ruoyi-fastapi-react-web",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build",
    "build:docker": "vite build --mode docker",
    "build:stage": "vite build --mode staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:contract",
    "test:unit": "pnpm test:auth-center && pnpm test:plugin && pnpm test:job",
    "test:contract": "pnpm test:time",
    "test:job": "node --test tests/job/*.test.js",
    "test:plugin": "node --test tests/plugins/*.test.js && pnpm test:components tests/react/pluginFrame.test.jsx tests/react/plugin-status.test.jsx",
    "test:auth-center": "node --test tests/auth-center/*.test.js && pnpm test:components tests/react/useInteraction.test.jsx",
    "test:time": "node --test tests/time/time.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/x": "2.9.0",
    "antd": "6.6.5",
    "axios": "1.19.0",
    "dayjs": "1.11.23",
    "dompurify": "^3.4.16",
    "echarts": "6.1.0",
    "file-saver": "2.0.5",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.3.2",
    "katex": "^0.19.0",
    "markstream-react": "2.0.17",
    "mermaid": "^12.1.0",
    "monaco-editor": "0.55.1",
    "quill": "^2.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "7.9.4",
    "stream-diffs": "0.0.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.6.2",
    "vite": "8.3.4",
    "vite-plugin-compression": "0.5.1",
    "vitest": "5.0.3"
  }
}
