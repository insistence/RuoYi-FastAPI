{
  "name": "vfadmin",
  "version": "1.10.0",
  "description": "vfadmin管理系统",
  "author": "insistence",
  "license": "MIT",
  "scripts": {
    "dev": "vue-cli-service serve",
    "build:prod": "vue-cli-service build",
    "build:docker": "vue-cli-service build --mode docker",
    "build:stage": "vue-cli-service build --mode staging",
    "test:plugin": "node tests/plugins/run-plugin-tests.js",
    "preview": "node build/index.js --preview",
    "test:time": "node --test tests/time/time.test.mjs",
    "test:job": "node --test tests/job/job-form.test.mjs tests/job/vue2-components.test.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth-center": "node --test tests/auth-center/*.test.cjs",
    "test:unit": "pnpm run test:auth-center && pnpm run test:plugin && pnpm run test:job",
    "test:contract": "pnpm run test:time",
    "test": "pnpm run test:unit && pnpm run test:contract"
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-ui",
    "boilerplate",
    "admin-template",
    "management-system"
  ],
