{
  "name": "ruoyi-fastapi-vue3-mobile",
  "version": "2.0.0",
  "description": "RuoYi-FastAPI Vue3 移动端",
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:time": "pnpm run test:contract",
    "test:unit": "node --experimental-vm-modules --test tests/behavior.test.mjs",
    "test:contract": "node --test tests/time*.test.js",
    "test": "pnpm run test:unit && pnpm run test:contract",
    "dev": "uni -p mp-weixin",
    "build": "pnpm run build:mp-weixin",
    "dev:app": "uni -p app",
    "dev:custom": "uni -p",
    "dev:h5": "uni --host",
    "dev:h5:ssr": "uni --ssr",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
    "dev:mp-kuaishou": "uni -p mp-kuaishou",
    "dev:mp-lark": "uni -p mp-lark",
    "dev:mp-qq": "uni -p mp-qq",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:quickapp-webview": "uni -p quickapp-webview",
    "dev:quickapp-webview-huawei": "uni -p quickapp-webview-huawei",
    "dev:quickapp-webview-union": "uni -p quickapp-webview-union",
    "build:app": "uni build -p app",
    "build:custom": "uni build -p",
    "build:h5": "uni build",
    "build:h5:ssr": "uni build --ssr",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:mp-baidu": "uni build -p mp-baidu",
    "build:mp-kuaishou": "uni build -p mp-kuaishou",
    "build:mp-lark": "uni build -p mp-lark",
    "build:mp-qq": "uni build -p mp-qq",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:quickapp-webview": "uni build -p quickapp-webview",
    "build:quickapp-webview-huawei": "uni build -p quickapp-webview-huawei",
    "build:quickapp-webview-union": "uni build -p quickapp-webview-union",
    "open:dev": "weapp open -p dist/dev/mp-weixin",
    "open:build": "weapp open -p dist/build/mp-weixin",
    "weapp:login": "weapp login",
    "upload:dev": "weapp upload -p dist/dev/mp-weixin -v 1.0.0 -d \"dev version\"",
    "upload:build": "weapp upload -p dist/build/mp-weixin -v 1.0.0 -d \"release version\"",
    "up:pkg": "pnpm up -rLi \"!@dcloudio/*\"",
    "up:uniapp": "pnpm dlx @dcloudio/uvm@latest",
    "i18n:check": "node scripts/check-i18n.mjs && x18n --root . check --json",
    "test:i18n": "node --test tests/i18n/*.test.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-harmony": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-alipay": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-baidu": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-harmony": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-jd": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-lark": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-qq": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-xhs": "3.0.0-5020620260917001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-5020620260917001",
    "@formatjs/intl-datetimeformat": "7.8.1",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-numberformat": "9.4.3",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@vue/shared": "3.4.21",
    "dayjs": "1.11.23",
    "i18next": "26.5.11",
    "node-forge": "1.4.0",
    "pinia": "2.2.4",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@egoist/tailwindcss-icons": "1.9.2",
    "@icebreakers/stylelint-config": "1.2.6",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/svg-spinners": "1.2.4",
    "@types/node": "22.20.5",
    "@vue/runtime-core": "3.4.21",
    "@x18n/cli": "0.1.3",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unplugin-auto-import": "20.3.0",
    "vite": "5.4.21",
    "weapp-ide-cli": "5.4.12",
    "weapp-tailwindcss": "5.6.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
