{
  "name": "ruoyi-fastapi-vue3-web",
  "version": "2.0.0",
  "description": "RuoYi-FastAPI Vue3 Web 管理端",
  "author": "insistence",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build:docker": "vite build --mode docker",
    "build:stage": "vite build --mode staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:contract",
    "test:unit": "pnpm run test:auth-center && pnpm run test:plugin && pnpm run test:job",
    "test:contract": "pnpm run test:time",
    "test:job": "node tests/run-tests.js job",
    "test:plugin": "node tests/run-tests.js plugins",
    "test:auth-center": "node tests/run-tests.js auth-center",
    "test:time": "node --test tests/time/time.test.js",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/insistence2022/RuoYi-FastAPI.git"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@antv/g2plot": "2.4.35",
    "@antv/infographic": "0.2.20",
    "@element-plus/icons-vue": "2.3.2",
    "@terrastruct/d2": "0.1.33",
    "@vueup/vue-quill": "1.5.5",
    "@vueuse/core": "14.4.0",
    "ant-design-vue": "4.2.6",
    "axios": "1.20.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "element-plus": "2.14.7",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "js-beautify": "1.15.4",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.5.4",
    "katex": "0.19.0",
    "markstream-vue": "2.0.19",
    "mermaid": "12.2.0",
    "monaco-editor": "0.55.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "shiki": "3.23.0",
    "sortablejs": "1.15.7",
    "stream-diffs": "0.0.2",
    "uuid": "14.0.3",
    "vue": "3.5.44",
    "vue-cropper": "1.1.4",
    "vue-router": "4.6.4",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "esbuild": "0.28.2",
    "less": "4.9.1",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.2",
    "unplugin-auto-import": "0.18.6",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "8.3.4",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-monaco-editor-esm": "2.0.3",
    "vite-plugin-svg-icons": "2.0.1"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
